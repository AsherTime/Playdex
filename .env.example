# Supabase (required)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Vercel Cron — generate a long random string (required in production)
CRON_SECRET=replace-with-long-random-string

# Public site URL (Vercel production). Used by Capacitor Android shell + deep links.
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app
CAPACITOR_SERVER_URL=https://your-app.vercel.app
